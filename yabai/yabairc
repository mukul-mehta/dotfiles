#!/bin/sh

set -u

PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

YABAI="$(command -v yabai 2>/dev/null || true)"

if [ -z "$YABAI" ]; then
  printf '%s\n' "yabai: executable not found" >&2
  exit 1
fi

"$YABAI" -m signal --remove reload-sa 2>/dev/null || true

"$YABAI" -m signal --add \
  label=reload-sa \
  event=dock_did_restart \
  action="sudo -n $YABAI --load-sa"

if ! sudo -n "$YABAI" --load-sa 2>/dev/null; then
  printf '%s\n' \
    "yabai: scripting addition was not loaded; check the sudoers entry" >&2
fi

# -----------------------------------------------------------------------------
# Global configuration
# -----------------------------------------------------------------------------

"$YABAI" -m config \
  external_bar               all:40:0       \
  layout                     bsp            \
  split_type                 auto           \
  split_ratio                0.50           \
  auto_balance               off            \
  window_origin_display      focused        \
  window_placement           second_child   \
  window_insertion_point     focused        \
  window_zoom_persist        off            \
  mouse_follows_focus        off            \
  focus_follows_mouse        off            \
  window_shadow              float          \
  window_opacity             on             \
  window_opacity_duration    0.12           \
  active_window_opacity      1.0            \
  normal_window_opacity      0.90           \
  window_animation_duration  0.12           \
  window_animation_easing    ease_out_quint \
  insert_feedback_color      0xff9dd274     \
  mouse_modifier             fn             \
  mouse_action1              move           \
  mouse_action2              resize         \
  mouse_drop_action          swap           \
  top_padding                8              \
  bottom_padding             8              \
  left_padding               8              \
  right_padding              8              \
  window_gap                 10

# -----------------------------------------------------------------------------
# Rules
# -----------------------------------------------------------------------------

add_rule() {
  label="$1"
  shift

  "$YABAI" -m rule --remove "$label" 2>/dev/null || true
  "$YABAI" -m rule --add label="$label" "$@"
}

add_rule float-apps \
  app='^(LuLu|Calculator|Software Update|Dictionary|VLC|System Preferences|System Settings|zoom\.us|Zoom Workplace|Photo Booth|Archive Utility|Python|LibreOffice|App Store|Steam|Alfred|Activity Monitor)$' \
  manage=off

add_rule float-dialogs \
  subrole='^AXDialog$' \
  manage=off

add_rule float-system-dialogs \
  subrole='^AXSystemDialog$' \
  manage=off

add_rule finder-dialogs \
  app='^Finder$' \
  title='^(Copy|Connect|Move|Info|Preferences|Rename)' \
  manage=off

add_rule safari-settings \
  app='^Safari$' \
  title='^(General|Tabs|Passwords|Websites|Extensions|AutoFill|Search|Security|Privacy|Advanced)$' \
  manage=off

add_rule about-this-mac \
  app='^System Information$' \
  title='^About This Mac$' \
  manage=off

add_rule inkscape-save-dialog \
  app='^Inkscape$' \
  title='^Select file to save to$' \
  manage=off

"$YABAI" -m rule --apply

# -----------------------------------------------------------------------------
# Optional global space labels
#
# These labels use global Mission Control indices. The Caps number bindings in
# skhdrc instead use display-local positions.
# -----------------------------------------------------------------------------

label_space() {
  index="$1"
  label="$2"

  if "$YABAI" -m query --spaces --space "$index" >/dev/null 2>&1; then
    "$YABAI" -m space "$index" --label "$label" 2>/dev/null || true
  fi
}

label_space 1 Code
label_space 1 Code - Personal
label_space 3 Terminal
label_space 4 Browser
label_space 8 Communication

printf '%s\n' "yabai configuration loaded"
